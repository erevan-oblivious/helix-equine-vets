---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';


const contactMethods = [

  {
    title: "WhatsApp Messenger",
    eyebrow: "Primary Routine Contact",
    description: "The fastest way to book routine yard visits, request repeat prescriptions, or share photos and videos with Max.",
    actionText: "Message on WhatsApp",
    actionLink: "https://wa.me/447919533576?text=Hi%20Max%2C%20I%27d%20like%20to%20enquire%20about%20a%20yard%20visit%20for%20my%20horse.",
    variant: "whatsapp",
    icon: `<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>`
  },

  {
    title: "Direct Line",
    eyebrow: "Urgent Veterinary Care",
    description: "For immediate emergency triage, acute lameness, colic, or severe wounds. Call now.",
    actionText: "Call 07919 533 576",
    actionLink: "tel:07919533576",
    variant: "emergency",
    icon: `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>`
  },

  {
    title: "New Horse Registration",
    eyebrow: "New Clients and Horses",
    description: "Register your horse, pony, or yard online with Helix Equine Vets in under two minutes prior to our first visit.",
    actionText: "Register Online",
    actionLink: "#register-form",
    variant: "standard",
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>`
  },

  {
    title: "Surgery Email",
    eyebrow: "General & Administrative",
    description: "For administrative enquiries, passport submissions, veterinary history transfers, and general non-urgent correspondence.",
    actionText: "surgery@helixequinevets.co.uk",
    actionLink: "mailto:surgery@helixequinevets.co.uk",
    variant: "standard",
    icon: `<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>`
  },

];
---

<BaseLayout 
  title="Contact | Helix Equine Vets"
  description="Get in touch with us now for routine enquiries or emergencies"
>

<section class="contact-section">
  <div class="contact-container">
    
    <div class="section-header">
      <span class="section-eyebrow">Get In Touch</span>
      <h2 class="section-title">How Can We Help You?</h2>
      <p class="section-description">
        Choose your preferred contact method below. For urgent clinical emergencies outside routine hours, please always call our emergency line directly.
      </p>
    </div>

    <div class="contact-grid">
      {contactMethods.map((item) => (
        <div class={`contact-card card-${item.variant}`}>
          <div class="card-header">
            <div class="icon-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
            </div>
            <span class="card-eyebrow">{item.eyebrow}</span>
          </div>

          <h3 class="card-title">{item.title}</h3>
          <p class="card-description">{item.description}</p>

          <a 
            href={item.actionLink} 
            class={`btn-contact btn-${item.variant}`}
            target={item.actionLink.startsWith("http") ? "_blank" : "_self"}
            rel={item.actionLink.startsWith("http") ? "noopener noreferrer" : ""}
          >
            {item.actionText}
          </a>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .contact-section {
    padding: 5rem 1.5rem;
    background-color: var(--color-bg-site);
  }

  .contact-container {
    max-width: var(--max-width-wide, 71.25rem);
    margin: 0 auto;
  }

  /* Header Typography */
  .section-header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 3.5rem;
  }

  .section-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-teal);
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4vw, 3rem);
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0 0 1rem 0;
  }

  .section-description {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Contact Grid */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  /* Card Base Styles */
  .contact-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 4px rgba(11, 34, 64, 0.02);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .contact-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(11, 34, 64, 0.06);
  }

  /* Card Variant Accents */
  .contact-card.card-emergency {
    border-top: 3px solid var(--color-emergency, #A62B2B);
  }

  .contact-card.card-whatsapp {
    border-top: 3px solid #25D366;
  }

  .contact-card.card-standard {
    border-top: 3px solid var(--color-teal);
  }

  /* Header Elements */
  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .icon-badge {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-emergency .icon-badge {
    background-color: rgba(166, 43, 43, 0.1);
    color: var(--color-emergency, #A62B2B);
  }

  .card-whatsapp .icon-badge {
    background-color: rgba(37, 211, 102, 0.1);
    color: #1eb954;
  }

  .card-standard .icon-badge {
    background-color: rgba(0, 91, 96, 0.08);
    color: var(--color-teal);
  }

  .card-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.2;
    margin: 0 0 0.75rem 0;
  }

  .card-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 2rem 0;
    flex-grow: 1;
  }

  /* Action Buttons */
  .btn-contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.8125rem 1rem;
    border-radius: var(--radius-sm, 6px);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    text-align: center;
    margin-top: auto;
  }

  /* Button Variations */
  .btn-emergency {
    background-color: var(--color-emergency, #A62B2B);
    color: #ffffff;
  }

  .btn-emergency:hover {
    background-color: var(--color-emergency-hover, #852222);
  }

  .btn-whatsapp {
    background-color: #25D366;
    color: #ffffff;
  }

  .btn-whatsapp:hover {
    background-color: #20ba5a;
  }

  .btn-standard {
    background-color: var(--color-navy);
    color: #ffffff;
  }

  .btn-standard:hover {
    background-color: var(--color-teal);
  }

  @media (max-width: 640px) {
    .contact-section {
      padding: 3.5rem 1rem;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>


</BaseLayout>