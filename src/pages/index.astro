---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import LogoImg from '../images/helix-logo-2.png';
import LogoImgLight from '../images/helix-logo-1.jpg';
import ValuesSection from '../components/ValuesSection.astro';
import PageNavigationGrid from '../components/PageNavigationGrid.astro';

---

<BaseLayout 
  title="Home | Helix Equine Vets"
  description="Equine Vets in Northumberland and Newcastle"
>

<section class="hero">
  <div class="hero-container">

    <!-- Main Title -->
    <h1 class="hero-title">
      Independent Equine Veterinary Care Across Northumberland
    </h1>

    <!-- Subheading / Value Proposition -->
    <p class="hero-lead">
      Experience, continuity and clinical excellence
    </p>

    <!-- Body Description -->
    <p class="hero-description">
      Helix Equine Vets is an independent, fully mobile equine veterinary practice serving Northumberland and Newcastle. No clinic to travel to — we bring advanced veterinary care directly to your yard.
    </p>

    <!-- Action Buttons -->
    <div class="hero-actions">

      <a 
        href="https://wa.me/447919533576?text=Hi%20Max%2C%20I%27d%20like%20to%20enquire%20about%20a%20yard%20visit%20for%20my%20horse." 
        class="btn btn-whatsapp"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Message Helix Equine Vets on WhatsApp"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.205 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 4.762 1.213 4.96c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Enquire on WhatsApp</span>
      </a>

      <a href="tel:07919533576" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Emergency Call Now</span>
      </a>

      <a href="/register" class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
          <!-- Document outline with plus badge -->
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
          <line x1="12" y1="11" x2="12" y2="17" />
          <line x1="9" y1="14" x2="15" y2="14" />
        </svg>
        <span>New Horse Registration</span>
      </a>

    </div>


  </div>
</section>

<ValuesSection />

</BaseLayout>