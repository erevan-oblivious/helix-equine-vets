---
// src/pages/register/thank-you.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Registration Confirmed | Helix Equine Vets" 
  description="Thank you for registering your horse with Helix Equine Vets. Review your next steps or book a visit."
>

<section class="thankyou-section">
  <div class="thankyou-container">
    
    <!-- SUCCESS BADGE & HEADER -->
    <div class="thankyou-header">
      <div class="success-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <span class="eyebrow">Registration Complete</span>
      <h1 class="title">Welcome to Helix Equine Vets</h1>
      <p class="subtitle">
        Thank you for onboarding your horse with us. Your details have been securely logged in our system.
      </p>
    </div>

    <!-- NEXT STEPS TIMELINE CARDS -->
    <div class="next-steps-card">
      <h2 class="steps-title">What Happens Next?</h2>

      <div class="steps-list">
        
        <!-- STEP 1 -->
        <div class="step-item">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Medical History Transfer</h3>
            <p>If you requested a history transfer, our administration team will contact your previous veterinary practice to collect past clinical notes and vaccination records.</p>
          </div>
        </div>

        <!-- STEP 2 -->
        <div class="step-item">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>Booking Your First Routine Visit</h3>
            <p>Need to arrange vaccinations, dental care, or a health check? Message Max on WhatsApp anytime.</p>
          </div>
        </div>

        <!-- STEP 3 -->
        <div class="step-item">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>Save Our Number</h3>
            <p>Save our number for WhatsApp and emergency calls for peace of mind.</p>
            <p><strong>07919 533 576</strong></p>
          </div>
        </div>

      </div>
    </div>

    <!-- PRIMARY ACTION BUTTONS -->
    <div class="action-bar">
      <a 
        href="https://wa.me/447XXXXXXXXX?text=Hi%20Max%2C%20I%27ve%20just%20completed%20the%20online%20registration%20form." 
        class="btn-action btn-whatsapp"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        <span>Message Max on WhatsApp</span>
      </a>

      <a href="/" class="btn-action btn-secondary">
        <span>Return to Homepage</span>
      </a>
    </div>

  </div>
</section>

<style>
  .thankyou-section {
    padding: 5rem 1.5rem;
    background-color: var(--color-bg-site);
  }

  .thankyou-container {
    max-width: 680px;
    margin: 0 auto;
  }

  /* Header */
  .thankyou-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .success-badge {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: rgba(0, 91, 96, 0.1);
    color: var(--color-teal);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    border: 2px solid rgba(0, 91, 96, 0.2);
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-teal);
    display: block;
    margin-bottom: 0.5rem;
  }

  .title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4vw, 3rem);
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0 0 1rem 0;
  }

  .subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Steps Card Container */
  .next-steps-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    padding: 2.25rem 2rem;
    box-shadow: 0 4px 16px rgba(11, 34, 64, 0.03);
    margin-bottom: 2.5rem;
  }

  .steps-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-navy);
    border-bottom: 1.5px solid var(--color-border);
    padding-bottom: 0.75rem;
    margin: 0 0 1.75rem 0;
  }

  /* Steps Timeline List */
  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .step-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .step-number {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--color-navy);
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .step-content h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 0.375rem 0;
    line-height: 1.25;
  }

  .step-content p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-main);
    margin: 0;
  }

  .emergency-text {
    color: var(--color-emergency, #A62B2B);
    font-weight: 700;
  }

  /* Action Buttons */
  .action-bar {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: 100%;
    padding: 0.9375rem 1.5rem;
    border-radius: var(--radius-sm, 6px);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    text-align: center;
  }

  .btn-whatsapp {
    background-color: #25D366;
    color: #ffffff;
  }

  .btn-whatsapp:hover {
    background-color: #20ba5a;
    transform: translateY(-1px);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-navy);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background-color: var(--color-bg-surface);
    border-color: var(--color-navy);
  }

  @media (max-width: 640px) {
    .thankyou-section {
      padding: 3rem 1rem;
    }

    .next-steps-card {
      padding: 1.5rem 1.25rem;
    }

    .step-item {
      gap: 1rem;
    }
  }
</style>

</BaseLayout>