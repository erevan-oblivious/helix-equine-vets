---
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import LogoImg from '../images/helix-logo-2.png';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import PageNavigationGrid from '../components/PageNavigationGrid.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Helix Equine Vets", 
  description = "Helix Equine Vets - Independent Equine Veterinary Care Across Northumberland and Newcastle.",
  image = "/helix-logo-1.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
---

<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/helix-favicon.svg" />
    <link rel="icon" href="/helix-favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/helix-favicon.png" />

</head>

<body>

<a href="#main-content" class="skip-link">Skip to main content</a>

<header class="header">
  <div class="header-inner">
      <a href="/" class="logo-link">
        <Image src={LogoImg} alt="Helix Equine Vets" class="header-logo" loading="eager"/>
      </a>

    <!-- Hamburger Toggle Button -->
    <button 
      class="hamburger" 
      id="hamburger-btn" 
      aria-label="Toggle navigation menu" 
      aria-expanded="false" 
      aria-controls="nav-menu"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <!-- Navigation Menu -->
    <nav class="nav-links" id="nav-menu">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/services">Services</a>
      <a href="/pricing">Pricing</a>
      <!-- <a href="/contact">Contact</a> add this component back in when live-->
    </nav>

    <script>
      const hamburgerBtn = document.getElementById('hamburger-btn');
      const navMenu = document.getElementById('nav-menu');

      if (hamburgerBtn && navMenu) {
        const toggleMenu = (open?: boolean) => {
          const state = open ?? !navMenu.classList.contains('is-active');
          navMenu.classList.toggle('is-active', state);
          hamburgerBtn.classList.toggle('is-active', state);
          hamburgerBtn.setAttribute('aria-expanded', state.toString());
        };

        hamburgerBtn.addEventListener('click', () => toggleMenu());

        // Close menu on Escape key press
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && navMenu.classList.contains('is-active')) {
            toggleMenu(false);
            hamburgerBtn.focus();
          }
        });
      }
    </script>

  </div>

</header>

<main class="main" id="main-content">

  <slot />

  <PageNavigationGrid />

</main>

<footer class="footer">
  <hr class="divider-full">

  <p>Helix Equine Vets</p>
  <p>&copy; {new Date().getFullYear()} Helix Equine Vets. All rights reserved.</p>
  
  <nav class="footer-nav" aria-label="Legal navigation">
    <a href="/privacy">Privacy Policy</a>
    <a href="/cookies">Cookie Policy</a>
    <a href="/accessibility">Accessibility Statement</a>
  </nav>

</footer>

<!--  <WhatsAppFloat /> Add when go live-->

</body>

</html>