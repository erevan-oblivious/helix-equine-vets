---
const pages = [
  {
    title: "Our Services",
    description: "Comprehensive equine healthcare delivered directly to your yard, from routine health checks to advanced diagnostics.",
    link: "/services",
    linkText: "Explore Services",
    accent: "gold"
  },

  {
    title: "About Us",
    description: "Helix Equine Vets is an independent practice delivered by Max Ling with a focus on consistency and genuine dedication to equine welfare.",
    link: "/about",
    linkText: "Read Our Story",
    accent: "teal"
  },

  {
    title: "Pricing",
    description: "Transparent pricing for all services, with no hidden fees. We provide clear estimates wherever possible.",
    link: "/pricing",
    linkText: "View Pricing",
    accent: "gold"
  },

];
---

<section class="nav-grid-section">
  <div class="nav-grid-container">
    
    <div class="section-header">
      <span class="section-eyebrow">What we do</span>
      <h2 class="section-title">Our Practice</h2>
    </div>

    <div class="cards-grid">
      {pages.map((item) => (
        <a href={item.link} class={`nav-card accent-${item.accent}`}>
          <!-- Top Decorative Bar -->
          <div class="card-border-top"></div>
          
          <div class="card-content">
            <div class="card-meta">
            </div>
            
            <h3 class="card-title">{item.title}</h3>
            <p class="card-description">{item.description}</p>
            
            <div class="card-action">
              <span class="action-text">{item.linkText}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="action-arrow">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .nav-grid-section {
    padding: 5rem 1.5rem;
    background-color: var(--color-bg-site);
  }

  .nav-grid-container {
    max-width: var(--max-width-wide, 71.25rem);
    margin: 0 auto;
  }

  /* Section Header */
  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 3.5rem;
  }

  .section-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-teal);
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0;
  }

  /* Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.75rem;
  }

  /* Card Container */
  .nav-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-surface); /* Pure White (#FFFFFF) */
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s ease;
  }

  /* Subtle Top Border Accent Line */
  .card-border-top {
    height: 3px;
    width: 100%;
    background-color: transparent;
    transition: background-color 0.25s ease;
  }

  .nav-card.accent-gold .card-border-top {
    background-color: var(--color-gold);
  }

  .nav-card.accent-teal .card-border-top {
    background-color: var(--color-teal);
  }

  /* Inner Padding */
  .card-content {
    padding: 2rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  /* Card Meta & Numbering */
  .card-meta {
    margin-bottom: 1rem;
  }

  /* Typography */
  .card-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.25;
    margin: 0 0 0.75rem 0;
    transition: color 0.2s ease;
  }

  .card-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 2rem 0;
    flex-grow: 1;
  }

  /* Action Link & Animated Arrow */
  .card-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy);
    margin-top: auto;
  }

  .action-arrow {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }

  /* Hover States */
  .nav-card:hover {
    transform: translateY(-4px);
    border-color: rgba(11, 34, 64, 0.18);
    box-shadow: 0 12px 28px -6px rgba(11, 34, 64, 0.08);
  }

  .nav-card:hover .card-title {
    color: var(--color-teal);
  }

  .nav-card:hover .action-arrow {
    transform: translateX(5px);
    color: var(--color-gold);
  }

  .nav-card:hover .action-text {
    color: var(--color-teal);
  }

  @media (max-width: 640px) {
    .nav-grid-section {
      padding: 3.5rem 1rem;
    }
    
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>