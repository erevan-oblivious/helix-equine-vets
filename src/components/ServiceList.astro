---
const services = [
  "Routine preventative healthcare & vaccinations",
  "Emergency and out-of-hours treatment",
  "Equine dentistry",
  "Lameness investigations & advanced diagnostic imaging",
  "Poor performance work-ups",
  "Event and racing cover",
  "On-site laboratory diagnostics",
  "Pre-purchase examinations"
];
---

<section class="services-simple-section">
  <div class="services-simple-container">
    
    <div class="section-header">
      <span class="section-eyebrow">Delivered to Your Stable</span>
      <h1 class="section-title">Our Services</h1>
    </div>

    <ul class="services-list-grid">
      {services.map((service) => (
        <li class="service-item">
          <div class="check-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <span class="service-text">{service}</span>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .services-simple-section {
    padding: 4.5rem 1.5rem;
    background-color: var(--color-bg-site);
  }

  .services-simple-container {
    max-width: var(--max-width-wide, 71.25rem);
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  .section-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-teal);
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0;
  }

  /* Grid Container */
  .services-list-grid {
    list-style: none;
    max-width: 720px; /* Keeps card width comfortable and centered on desktop */
    padding: 0;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  /* List Item Card */
  .service-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    box-shadow: 0 2px 4px rgba(11, 34, 64, 0.02);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .service-item:hover {
    transform: translateY(-2px);
    border-color: var(--color-teal); /* Warm gold subtle highlight */
    box-shadow: 0 6px 16px rgba(11, 34, 64, 0.06);
  }

  /* Checkmark Badge */
  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--color-teal);
    flex-shrink: 0;
  }

  /* Service Title Text */
  .service-text {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-teal);
    line-height: 1.35;
  }

  @media (max-width: 640px) {
    .services-simple-section {
      padding: 3rem 1rem;
    }

    .services-list-grid {
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }

    .service-item {
      padding: 1rem 1.25rem;
    }
  }
</style>