---
// src/components/NewHorseFloat.astro

---

<a 
  href=/new-horse
  class="newhorse-float" 
  target="_blank" 
  rel="noopener noreferrer"
  aria-label="Register your horse with Helix Equine Vets"
>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width="22" 
    height="22" 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke="currentColor" 
    stroke-width="2" 
    stroke-linecap="round" 
    stroke-linejoin="round"
  >
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
    <polyline points="14 2 14 8 20 8"></polyline>
    <line x1="12" y1="11" x2="12" y2="17"></line>
    <line x1="9" y1="14" x2="15" y2="14"></line>
  </svg>
  <span class="newhorse-label">Register</span>
</a>

<style>
  .newhorse-float {
    position: fixed;
    bottom: 6rem;
    right: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    background-color: #0B2240;
    color: #ffffff;
    padding: 0.75rem 1.25rem;
    border-radius: 9999px;
    box-shadow: 0 4px 14px rgba(231, 231, 231, 0.15);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 600;
    z-index: 999; /* Stacks above page content */
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .newhorse-float:hover {
    background-color: #0B2240;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
  }

  /* Responsive behavior for mobile */
  @media (max-width: 640px) {
    .newhorse-float {
      bottom: 1rem;
      right: 1rem;
      padding: 0.875rem; /* Circular button on small screens */
      border-radius: 50%;
    }

    .newhorse-label {
      display: none; /* Hide text label on small mobile screens to save space */
    }
  }
</style>